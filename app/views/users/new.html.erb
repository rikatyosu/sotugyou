<h1>Users#new</h1>
<p>Find me in app/views/users/new.html.erb</p>
<h1>新規登録</h1>
<%= form_with model: @user, local: true do |f| %>
  <div><%= f.label :email %><br><%= f.email_field :email %></div>
  <div><%= f.label :password %><br><%= f.password_field :password %></div>
  <div><%= f.label :password_confirmation %><br><%= f.password_field :password_confirmation %></div>
  <%= f.submit '登録：6文字以上' %>
<% end %>
<% if @user.errors.any? %>
  <div class="error-messages">
    <h2><%= pluralize(@user.errors.count, "件のエラー") %>が発生しました：</h2>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

